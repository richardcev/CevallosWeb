---
const technologies = [
  ['HTML', 'html5'], ['CSS', 'css3'], ['JavaScript', 'javascript'], ['Python', 'python'], ['React.js', 'react'], ['Astro', 'astro'],
  ['Django', 'django'], ['FastAPI', 'fastapi'], ['WordPress', 'wordpress'], ['Hostinger', 'hostinger'], ['Claude Code', 'claudecode'], ['Codex', 'codex'],
];
---
<section id="tecnologias" class="section light-section technologies-section">
  <div class="container">
    <div class="center-heading" data-reveal><h2>Tecnologías &amp; herramientas</h2><p>Como desarrollador web domino un stack completo de tecnologías modernas para crear soluciones web robustas, escalables y adaptadas a las necesidades de cada proyecto. Esto me permite desarrollar desde sitios web profesionales hasta aplicaciones y sistemas complejos que optimizan los procesos de tu negocio.</p></div>
    <div class="technology-slider" data-reveal>
      <div id="technology-track" class="technology-track" role="region" aria-label="Tecnologías y herramientas. Carrusel automático; también puedes desplazarlo horizontalmente o utilizar las teclas de dirección." tabindex="0">
        {[...technologies, ...technologies].map(([label, file], index) => <div class="technology" aria-hidden={index >= technologies.length ? 'true' : undefined}><img src={`/technologies/${file}.svg`} alt={index >= technologies.length ? '' : `Logotipo de ${label}`} width="48" height="48" loading="lazy" /><span>{label}</span></div>)}
      </div>
    </div>
  </div>
</section>
<script>
  const track = document.querySelector<HTMLElement>('.technology-track');
  if (track) {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    let paused = false;
    let frame = 0;
    let lastTime = performance.now();
    const loopWidth = () => track.scrollWidth / 2;
    const tick = (time: number) => {
      const elapsed = Math.min(time - lastTime, 100);
      lastTime = time;
      if (!paused && !reduced.matches) {
        track.scrollLeft += elapsed * 0.09;
        if (track.scrollLeft >= loopWidth()) track.scrollLeft -= loopWidth();
      }
      frame = requestAnimationFrame(tick);
    };
    const move = (direction: number) => {
      paused = true;
      track.style.scrollBehavior = reduced.matches ? 'auto' : 'smooth';
      track.scrollBy({ left: direction * track.clientWidth * .8, behavior: reduced.matches ? 'instant' : 'smooth' });
      window.setTimeout(() => {
        track.style.scrollBehavior = 'auto';
        lastTime = performance.now();
        paused = false;
      }, 2200);
    };
    track.addEventListener('mouseenter', () => { paused = true; });
    track.addEventListener('mouseleave', () => { paused = false; });
    track.addEventListener('pointerdown', () => { paused = true; });
    track.addEventListener('pointerup', () => {
      window.setTimeout(() => { lastTime = performance.now(); paused = false; }, 1200);
    });
    track.addEventListener('pointercancel', () => { paused = false; });
    track.addEventListener('focusin', () => { paused = true; });
    track.addEventListener('focusout', () => { paused = false; });
    track.addEventListener('keydown', event => {
      if (['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) {
        event.preventDefault();
        if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') move(event.key === 'ArrowLeft' ? -1 : 1);
        else track.scrollTo({ left: event.key === 'Home' ? 0 : loopWidth(), behavior: reduced.matches ? 'instant' : 'smooth' });
      }
    });
    reduced.addEventListener('change', () => {
      track.style.scrollBehavior = 'auto';
      if (reduced.matches) track.scrollLeft = 0;
      lastTime = performance.now();
    });
    track.style.scrollBehavior = 'auto';
    frame = requestAnimationFrame(tick);
    window.addEventListener('pagehide', () => cancelAnimationFrame(frame), { once: true });
  }
</script>
